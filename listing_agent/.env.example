# Copia este archivo a .env (NUNCA lo subas a git) y rellénalo.

# --- SP-API (Seller Central → Apps y servicios → Desarrollar apps) ---
SP_API_CLIENT_ID=amzn1.application-oa2-client.xxxxx
SP_API_CLIENT_SECRET=xxxxx
SP_API_REFRESH_TOKEN=Atzr|xxxxx
SP_API_SELLER_ID=AXXXXXXXXXXXXX

# --- Email del informe (Gmail: usa una "contraseña de aplicación") ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_TO=tu_correo@gmail.com
# EMAIL_FROM=opcional

# --- Opcional: si un día tienes key, la redacción se hace sola en vez de con Cowork ---
# ANTHROPIC_API_KEY=sk-ant-...
